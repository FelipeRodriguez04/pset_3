# =============================================================================
# Copiar a .env y completar. .env NUNCA se sube a Git (ver .gitignore).
# =============================================================================

# --- Snowflake: lectura de la OBT del PSet 2 -----------------------------------
# Mismo usuario técnico que creó el flow ecu911.snowflake_setup del PSet 2
# (solo necesita leer ECU911.OBT.OBT_EMERGENCIAS_CANTON_DIA).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=ECU911_USER
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ECU911_ROLE
SNOWFLAKE_WAREHOUSE=ECU911_WH
SNOWFLAKE_DATABASE=ECU911

# --- Respaldo: si Snowflake no está disponible se lee este CSV ----------------
# Exportación de la misma tabla (no se versiona en Git: está en data/).
OBT_CSV_RESPALDO=data/obt_emergencias_canton_dia.csv

# --- MLflow --------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
# Contraseña de la base Postgres del backend store de MLflow (solo local)
MLFLOW_DB_PASSWORD=cambiar_esto
