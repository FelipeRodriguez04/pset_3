# Fuente de datos. Para las pruebas locales usar local; al crear la cuenta cambiar a snowflake.
DATA_SOURCE=local
OBT_LOCAL_PATH=./data/obt_emergencias_canton_dia.csv

# Snowflake (dejar vacio mientras DATA_SOURCE=local).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ECU911_ROLE
SNOWFLAKE_WAREHOUSE=ECU911_WH
SNOWFLAKE_DATABASE=ECU911
SNOWFLAKE_SCHEMA=OBT
SNOWFLAKE_TABLE=OBT_EMERGENCIAS_CANTON_DIA

# MLflow. El compose publica el servidor en este puerto.
MLFLOW_TRACKING_URI=http://127.0.0.1:5050
MLFLOW_EXPERIMENT_NAME=ecu911-alta-demanda-estacional
MLFLOW_MODEL_NAME=ecu911-alta-demanda-modelo

# Experimento reproducible y moderado para una laptop.
RANDOM_SEED=42
HOLDOUT_START=2026-04-01
PRIMARY_HORIZON=3
CV_SPLITS=4
MODEL_THREADS=2
TUNING_CONFIGS=30
LOG_TUNING_MODELS=false
